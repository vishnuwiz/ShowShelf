<?xml version="1.0" encoding="utf-8"?>
<!-- Static launch screen: charcoal with the play triangle where the animated splash
     (lib/ui/splash.dart) starts, so the reveal begins without a jump. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
